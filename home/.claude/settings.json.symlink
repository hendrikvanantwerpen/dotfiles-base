{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/private/tmp",
      "/tmp",
      "/Users/hvantwerpen/.cache",
      "/Volumes/HVACACHES"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "bazel:*",
      "cargo:*",
      "git bisect:*",
      "git diff:*",
      "git grep:*",
      "git log:*",
      "git show:*",
      "git status:*",
      "go:*",
      "tree-sitter:*"
    ],
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": ["crates.io", "go.dev"]
    }
  },
  "promptSuggestionEnabled": false,
  "skipDangerousModePermissionPrompt": true
}
